# MongoDB Atlas connection string. Use a database user with read/write access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/commonground?retryWrites=true&w=majority

# Better Auth (must be a long random secret; never commit the real value)
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API service URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional Google OAuth. Add both values to enable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
